{
  "name": "false-completion-bundle",
  "description": "Completion gate bundle: blocks done claims without verifiable evidence, records abort reasons, and exposes a read-only get_gate_status tool.",
  "version": "0.1.5",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20.6.0",
    "dsh": "^0.2.1-rc.5"
  },
  "packageManager": "pnpm@12.16.1",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./profiles/minimal.yml"
    }
  },
  "files": [
    "profiles/*.yml",
    "cordis.patch.yml",
    "dist/**",
    "src/**",
    "entry/index.ts",
    "python/mcp_verifier/requirements.txt",
    "python/mcp_verifier/server.py",
    "locale/en.json",
    "README.md",
    "ASSUMPTIONS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:regression": "tsc -p tsconfig.promptfoo.json && PROMPTFOO_CONFIG_DIR=./.promptfoo PROMPTFOO_TELEMETRY_DISABLED=1 promptfoo eval -c promptfooconfig.yaml --no-cache",
    "metrics": "node scripts/metrics.mjs",
    "build:bundle": "tsc -p tsconfig.bundle.json",
    "prepack": "pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "2.2.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.208.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "promptfoo": "^0.126.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/os1249399459/false-completion-bundle.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "completion-gate",
    "verification",
    "ai-agents",
    "guardrails"
  ],
  "bugs": {
    "url": "https://github.com/os1249399459/false-completion-bundle/issues"
  },
  "homepage": "https://github.com/os1249399459/false-completion-bundle#readme"
}
